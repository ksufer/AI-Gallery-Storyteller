# ============================================
# AI Gallery Storyteller - Docker 部署配置
# 复制此文件为 .env 后启动容器
# cp .env.example .env
# ============================================

# AI Provider: gemini 或 openai
AI_PROVIDER=gemini

# Gemini API Key (AI_PROVIDER=gemini 时使用)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI 兼容 API (AI_PROVIDER=openai 时使用)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o

# 代理设置 (访问国外 API 需要，可选)
# HTTPS_PROXY=http://127.0.0.1:10808

# 服务端口 (默认 3000)
PORT=3000
