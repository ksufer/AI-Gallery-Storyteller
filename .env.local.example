# ============================================
# AI Provider 配置 (AI Provider Configuration)
# ============================================

# AI 服务提供商选择 (AI Provider)
# 可选值: gemini (默认), openai
# 说明: 选择用于生成故事的 AI 服务
#      - gemini: 使用 Google Gemini API
#      - openai: 使用 OpenAI 兼容 API (支持 OpenRouter、DeepSeek、Moonshot 等)
AI_PROVIDER=gemini

# Google Gemini API Configuration
# 获取 API Key: https://aistudio.google.com/app/apikey
# 注意：仅当 AI_PROVIDER=gemini 时需要配置
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI 兼容 API 配置 (OpenAI Compatible API Configuration)
# 注意：仅当 AI_PROVIDER=openai 时需要配置

# OpenAI API Key
# 根据使用的服务获取对应的 API Key:
#   - OpenAI: https://platform.openai.com/api-keys
#   - OpenRouter: https://openrouter.ai/keys
#   - DeepSeek: https://platform.deepseek.com/
#   - Moonshot: https://platform.moonshot.cn/
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Base URL (可选)
# 说明: 自定义 API 端点地址，用于接入第三方兼容服务
# 默认值: https://api.openai.com/v1 (标准 OpenAI)
# 常用第三方服务示例:
#   - OpenRouter: https://openrouter.ai/api/v1
#   - DeepSeek: https://api.deepseek.com
#   - Moonshot (月之暗面): https://api.moonshot.cn/v1
#   - 阿里通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 智谱 GLM: https://open.bigmodel.cn/api/paas/v4
#   - 本地 Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Model (可选)
# 说明: 指定使用的模型名称
# 默认值: gpt-4o (支持视觉分析)
# OpenRouter 模型示例:
#   - openai/gpt-4o (OpenAI GPT-4o)
#   - anthropic/claude-3.5-sonnet (Anthropic Claude 3.5 Sonnet)
#   - google/gemini-2.0-flash-exp:free (免费的 Gemini 2.0 Flash)
#   - deepseek/deepseek-chat (DeepSeek Chat)
# 其他服务请参考各自文档
OPENAI_MODEL=openai/gpt-4o

# 代理设置 (Proxy Configuration)
# 说明: 如果在国内无法直接连接国外 API，请配置代理
# 常用的代理端口: 7890 (Clash), 10809 (v2ray), 7078 (Shadowsocks)
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================================
# 服务器配置 (Server Configuration)
# ============================================

# 服务器端口 (Server Port)
# 默认: 3000
# 说明: 设置服务器运行的端口号
PORT=3000

# 允许远程访问 (Enable Remote Access)
# 默认: false (仅本地访问)
# 说明: 设置为 true 时，服务器将监听 0.0.0.0，允许局域网内其他设备访问
#      设置为 false 时，服务器仅监听 127.0.0.1，只能本机访问
ENABLE_REMOTE_ACCESS=false

# 服务器主机地址 (Server Host)
# 默认: 127.0.0.1 (仅本地)
# 说明: 自定义服务器监听的主机地址
#      - 127.0.0.1 或 localhost: 仅本地访问
#      - 0.0.0.0: 允许所有网络接口访问(局域网+外网)
#      - 具体IP地址: 仅监听指定的网络接口
# 注意: 如果设置了 ENABLE_REMOTE_ACCESS=true，此项将被忽略
# HOST=127.0.0.1

# ============================================
# 使用说明
# ============================================
# 1. 将此文件复制为 .env.local
# 2. 选择 AI Provider (gemini 或 openai)
# 3. 根据选择的 Provider 配置对应的 API Key
# 4. 根据需要调整服务器配置
# 5. .env.local 已在 .gitignore 中，不会被提交到 Git
# 6. 请妥善保管你的 API Key，不要分享给他人

# ============================================
# OpenRouter 快速开始示例
# ============================================
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-or-v1-xxxxx  # 在 https://openrouter.ai/keys 获取
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash-exp:free  # 使用免费的 Gemini 模型

# ============================================
# 远程访问安全提示
# ============================================
# ⚠️  启用远程访问前请注意:
# - 确保在可信任的网络环境中使用
# - 考虑配置防火墙规则限制访问来源
# - 本应用未内置身份验证机制，启用远程访问意味着任何知道地址的人都可以访问
# - 建议仅在局域网内使用，避免暴露到公网
