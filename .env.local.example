# Google Gemini API Configuration
# 获取 API Key: https://aistudio.google.com/app/apikey
# 注意：请勿将包含真实 API Key 的 .env.local 文件提交到 Git

GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# 服务器配置 (Server Configuration)
# ============================================

# 服务器端口 (Server Port)
# 默认: 3000
# 说明: 设置服务器运行的端口号
PORT=3000

# 允许远程访问 (Enable Remote Access)
# 默认: false (仅本地访问)
# 说明: 设置为 true 时，服务器将监听 0.0.0.0，允许局域网内其他设备访问
#      设置为 false 时，服务器仅监听 127.0.0.1，只能本机访问
ENABLE_REMOTE_ACCESS=false

# 服务器主机地址 (Server Host)
# 默认: 127.0.0.1 (仅本地)
# 说明: 自定义服务器监听的主机地址
#      - 127.0.0.1 或 localhost: 仅本地访问
#      - 0.0.0.0: 允许所有网络接口访问(局域网+外网)
#      - 具体IP地址: 仅监听指定的网络接口
# 注意: 如果设置了 ENABLE_REMOTE_ACCESS=true，此项将被忽略
# HOST=127.0.0.1

# ============================================
# 使用说明
# ============================================
# 1. 将此文件复制为 .env.local
# 2. 将 your_gemini_api_key_here 替换为你的真实 API Key
# 3. 根据需要调整服务器配置
# 4. .env.local 已在 .gitignore 中，不会被提交到 Git
# 5. 请妥善保管你的 API Key，不要分享给他人

# ============================================
# 远程访问安全提示
# ============================================
# ⚠️  启用远程访问前请注意:
# - 确保在可信任的网络环境中使用
# - 考虑配置防火墙规则限制访问来源
# - 本应用未内置身份验证机制，启用远程访问意味着任何知道地址的人都可以访问
# - 建议仅在局域网内使用，避免暴露到公网
