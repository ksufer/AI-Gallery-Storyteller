# Google Gemini API Configuration
# 获取 API Key: https://aistudio.google.com/app/apikey
# 注意：请勿将包含真实 API Key 的 .env.local 文件提交到 Git

GEMINI_API_KEY=your_gemini_api_key_here

# 可选：自定义服务器端口（默认 3000）
# PORT=3000

# 说明：
# 1. 将此文件复制为 .env.local
# 2. 将 your_gemini_api_key_here 替换为你的真实 API Key
# 3. .env.local 已在 .gitignore 中，不会被提交到 Git
# 4. 请妥善保管你的 API Key，不要分享给他人
